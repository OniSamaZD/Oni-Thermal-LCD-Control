{
  "format": "oni-sensor-theme",
  "schema_version": 1,
  "id": "clean-hardware-monitor",
  "name": "Clean Hardware Monitor",
  "description": "A balanced, editable overview for thermals, load, memory, and power.",
  "author": "Oni Thermal LCD contributors",
  "canvas": {"width": 1280, "height": 480, "preset": "0416:5302", "scale_mode": "contain"},
  "background_color": "#071019",
  "metadata": {"category": "hardware", "editable": true},
  "elements": [
    {"id": "title", "name": "Title", "type": "text", "x": 30, "y": 18, "width": 760, "height": 48, "text": "HARDWARE MONITOR", "font_size": 25, "font_weight": 700, "letter_spacing": 1.5, "text_color": "#DCE5F5"},
    {"id": "date", "name": "Date", "type": "date", "x": 820, "y": 18, "width": 430, "height": 42, "font_size": 19, "alignment": "right", "text_color": "#738194", "date_format": "%a, %d %b %Y"},
    {"id": "cpu-label", "name": "CPU temperature label", "type": "sensor_label", "x": 35, "y": 100, "width": 210, "height": 35, "sensor_binding": "cpu.temperature", "text": "CPU TEMP", "font_size": 17, "font_weight": 600, "text_color": "#718096"},
    {"id": "cpu-value", "name": "CPU temperature value", "type": "sensor_value", "x": 35, "y": 135, "width": 230, "height": 65, "sensor_binding": "cpu.temperature", "unit": "°C", "font_size": 42, "font_weight": 700, "text_color": "#62B5FF"},
    {"id": "cpu-load", "name": "CPU load", "type": "horizontal_bar", "x": 35, "y": 218, "width": 350, "height": 18, "sensor_binding": "cpu.usage", "minimum": 0, "maximum": 100, "corner_radius": 9, "track_color": "#142334", "value_color": "#62B5FF"},
    {"id": "gpu-label", "name": "GPU temperature label", "type": "sensor_label", "x": 450, "y": 100, "width": 210, "height": 35, "sensor_binding": "gpu.temperature", "text": "GPU TEMP", "font_size": 17, "font_weight": 600, "text_color": "#718096"},
    {"id": "gpu-value", "name": "GPU temperature value", "type": "sensor_value", "x": 450, "y": 135, "width": 230, "height": 65, "sensor_binding": "gpu.temperature", "unit": "°C", "font_size": 42, "font_weight": 700, "text_color": "#A98CFF"},
    {"id": "gpu-load", "name": "GPU load", "type": "horizontal_bar", "x": 450, "y": 218, "width": 350, "height": 18, "sensor_binding": "gpu.usage", "minimum": 0, "maximum": 100, "corner_radius": 9, "track_color": "#211B35", "value_color": "#A98CFF"},
    {"id": "memory-label", "name": "Memory label", "type": "sensor_label", "x": 865, "y": 100, "width": 210, "height": 35, "sensor_binding": "memory.usage", "text": "MEMORY", "font_size": 17, "font_weight": 600, "text_color": "#718096"},
    {"id": "memory-value", "name": "Memory value", "type": "sensor_value", "x": 865, "y": 135, "width": 230, "height": 65, "sensor_binding": "memory.usage", "unit": "%", "font_size": 42, "font_weight": 700, "text_color": "#48E0B5"},
    {"id": "memory-bar", "name": "Memory bar", "type": "horizontal_bar", "x": 865, "y": 218, "width": 350, "height": 18, "sensor_binding": "memory.usage", "minimum": 0, "maximum": 100, "corner_radius": 9, "track_color": "#132A25", "value_color": "#48E0B5"},
    {"id": "power-label", "name": "GPU power label", "type": "sensor_label", "x": 35, "y": 310, "width": 210, "height": 34, "sensor_binding": "gpu.power", "text": "GPU POWER", "font_size": 17, "text_color": "#718096"},
    {"id": "power-value", "name": "GPU power value", "type": "sensor_value", "x": 35, "y": 345, "width": 260, "height": 58, "sensor_binding": "gpu.power", "unit": " W", "font_size": 34, "font_weight": 600, "text_color": "#FFD166"},
    {"id": "history", "name": "Combined load history", "type": "line_graph", "x": 450, "y": 295, "width": 765, "height": 125, "sensor_binding": "gpu.usage", "history_duration": 60, "line_width": 3, "fill": true, "fill_color": "#A98CFF20", "smoothing": true, "automatic_scale": false, "scale_min": 0, "scale_max": 100, "background_color": "#0A1622", "border_color": "#173047", "border_width": 1, "corner_radius": 10, "value_color": "#A98CFF"}
  ]
}
